# For pasting into a (HTTPS) server block in your nginx config.
# Don't forget to adjust the port,
# set the config.json webroot (no trailing slash in webroot).
# `location /amalthea/` -> webroot `https://domain.tls/amalthea`
# You can turn off access logging if you don't want to leak sharing tokens.
location / {
    client_max_body_size 5m;
    proxy_pass http://localhost:8080;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
}
